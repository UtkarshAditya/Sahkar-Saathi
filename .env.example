# Copy to `.env` (read by docker compose) and/or `.env.local` (read by `npm run dev`).
# Nothing here is required: `docker compose up --build` works with the defaults.

# --- Docker Compose: site and HTTPS ----------------------------------------------------
# Local run (default): http://localhost. localhost is a secure context, so the
# microphone works without HTTPS.
SITE_ADDRESS=http://localhost
SITE_HOST=localhost
DJANGO_HTTPS=false
# Public deployment: point a DNS name at the server, then use it here. Caddy obtains and
# renews the HTTPS certificate automatically; ports 80 and 443 must be reachable.
#   SITE_ADDRESS=demo.example.org
#   SITE_HOST=demo.example.org
#   DJANGO_HTTPS=true
HTTP_PORT=80
HTTPS_PORT=443

# --- Docker Compose: app ---------------------------------------------------------------
# The team superuser for /admin/. Its password is generated on first start; read it with:
#   docker compose exec web cat /secrets/admin_password
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
# Load the sample library entries into an empty database on start.
LOAD_SAMPLE_DOCUMENTS=true
WEB_CONCURRENCY=2
# Team settings; see backend/.env.example for what each one does.
USE_STUBS=true
REGIONAL_LANGUAGE_CODE=ta
COVERED_STATE_CODE=TN
LLM_PROVIDER=
LLM_MODEL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- Front end (npm run dev) -----------------------------------------------------------
# Only variables prefixed with VITE_ reach the browser.
VITE_API_BASE_URL=/api/v1
# false (default): call the backend (Vite proxies /api to 127.0.0.1:8000).
# true: serve local mock data, for working on the UI without a backend.
VITE_USE_MOCKS=false

# Speech-to-text provider: "auto" uses browser recognition when supported,
# then falls back to the backend; "browser" forces browser recognition;
# "backend" records audio and posts it to /speech/transcribe.
VITE_STT_PROVIDER=auto

# Regional language shown as the third option. Strings live in src/i18n/locales/regional.json.
VITE_REGIONAL_LANGUAGE_CODE=ta
VITE_REGIONAL_LANGUAGE_LABEL=தமிழ்
