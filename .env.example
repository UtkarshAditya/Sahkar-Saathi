# Copy to .env.local and adjust. Only variables prefixed with VITE_ reach the browser.

# Base URL of the Django API. Caddy proxies /api to Django on the same origin.
VITE_API_BASE_URL=/api/v1

# "true" serves local mock data instead of calling the API. Keep true until the
# backend contract (openapi.json) is frozen and the endpoints exist.
VITE_USE_MOCKS=true

# Regional language shown as the third option. Strings live in src/i18n/locales/regional.json.
# Use a short ISO code (for example mr, ta, bn) and its name in that language.
VITE_REGIONAL_LANGUAGE_CODE=mr
VITE_REGIONAL_LANGUAGE_LABEL=मराठी
