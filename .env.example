# Copy to `.env` (read by docker compose) and/or `.env.local` (read by `npm run dev`).
# Nothing here is required: `docker compose up --build` works with the defaults.

# --- Docker Compose: site and HTTPS ----------------------------------------------------
# Local run (default): http://localhost. localhost is a secure context, so the
# microphone works without HTTPS.
SITE_ADDRESS=http://localhost
SITE_HOST=localhost
DJANGO_HTTPS=false
# Public deployment: point a DNS name at the server, then use it here. Caddy obtains and
# renews the HTTPS certificate automatically; ports 80 and 443 must be reachable.
#   SITE_ADDRESS=demo.example.org
#   SITE_HOST=demo.example.org
#   DJANGO_HTTPS=true
HTTP_PORT=80
HTTPS_PORT=443

# --- Docker Compose: app ---------------------------------------------------------------
# The team superuser for /admin/. Its password is generated on first start; read it with:
#   docker compose exec web cat /secrets/admin_password
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
# Load the sample library entries into an empty database on start.
LOAD_SAMPLE_DOCUMENTS=true
WEB_CONCURRENCY=2
# Team settings; see backend/.env.example for what each one does.
USE_STUBS=true
# Per-service overrides; empty follows USE_STUBS (true). Set false to turn a service real:
# real retrieval needs the corpus ingested first, the answer service needs an LLM below,
# speech uses Whisper, the grievance guide uses backend/services/data/forums.yaml. See
# docs/running-with-docker.md, sections 9, 10 and 12.
USE_STUB_RETRIEVER=
USE_STUB_ANSWER=
USE_STUB_SPEECH=
USE_STUB_GRIEVANCE=
# true: the scripted demo questions get their saved answers (backend/data/demo_answers.yaml),
# marked as demo answers, and those answers also replace an error if a live service fails.
# Other questions are unaffected. Turn it on for the evaluation as a safety net.
DEMO_CACHE=false
# Docker build: true (default) installs PyTorch and the retrieval packages into the API
# image (several GB). false builds a smaller stub-only image; real retrieval then fails.
INSTALL_ML=true
# Best retrieval score below which the assistant declines. Set it from the output of
# `docker compose exec web python manage.py eval_retrieval`, not by guessing: the right
# value depends on the embedding model. 0.82 is PROVISIONAL: it is based on six PMFBY-only
# evaluation questions. Re-tune it with eval_retrieval once Zainab adds real in-scope
# questions with expected documents.
SCORE_THRESHOLD=0.82
# Passages given to the answer service per question.
TOP_K=4
# Sentence-embedding model for retrieval; changing it means re-running ingest_corpus.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
REGIONAL_LANGUAGE_CODE=ta
COVERED_STATE_CODE=TN
# OpenAI-compatible LLM server. Default: Ollama on this machine, reached from the container.
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Model name as the server knows it.
LLM_MODEL=llama3.1:8b
# API key; Ollama ignores it, hosted providers need a real one.
LLM_API_KEY=ollama
# Seconds before an LLM call fails (empty = 60).
LLM_TIMEOUT=
# false if the provider rejects response_format=json_object (empty = true).
LLM_JSON_MODE=
# Whisper size: tiny, base, small, medium; bigger is slower and more accurate.
WHISPER_MODEL=small
# cpu or cuda.
WHISPER_DEVICE=cpu
# int8 (fast on CPU), float16 on a GPU.
WHISPER_COMPUTE_TYPE=int8
# Seconds to wait for the Whisper model at start-up before serving anyway.
WARM_TIMEOUT=300
# Who a declined answer tells people to contact. Only verified details; empty = default.
HELPLINE_LABEL=
HELPLINE_DETAIL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- Front end (npm run dev) -----------------------------------------------------------
# Only variables prefixed with VITE_ reach the browser.
VITE_API_BASE_URL=/api/v1
# false (default): call the backend (Vite proxies /api to 127.0.0.1:8000).
# true: serve local mock data, for working on the UI without a backend.
VITE_USE_MOCKS=false

# Speech-to-text: "backend" (default) records audio and posts it to /speech/transcribe.
# "auto" and "browser" use the browser's recognition, which sends audio to the browser vendor.
VITE_STT_PROVIDER=backend

# Regional language shown as the third option. Strings live in src/i18n/locales/regional.json.
VITE_REGIONAL_LANGUAGE_CODE=ta
VITE_REGIONAL_LANGUAGE_LABEL=தமிழ்
