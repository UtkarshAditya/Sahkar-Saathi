{
  "openapi": "3.1.0",
  "info": {
    "title": "Sahkar Saathi API",
    "version": "v1",
    "description": "Multilingual cooperative governance and legal-information assistant (SIH 2026, problem statement 26088). Every error uses the shape `{\"code\": \"...\", \"message\": \"...\"}`."
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "config_api_health",
        "summary": "Deployment check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        },
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/chat/ask": {
      "post": {
        "operationId": "apps_chat_api_ask",
        "summary": "Ask a question in text",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "description": "Answer a question from cited public documents, ask for a state, or decline.\n\nPass the returned ``conversation_id`` back with follow-up questions. The returned\n``message_id`` is what ``POST /feedback`` rates.",
        "tags": [
          "chat"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/speech/transcribe": {
      "post": {
        "operationId": "apps_speech_api_transcribe",
        "summary": "Speech to text",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "description": "Transcribe a spoken question. The client shows the text for the user to confirm.",
        "tags": [
          "speech"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "audio": {
                    "description": "Recorded question, e.g. audio/webm from MediaRecorder.",
                    "format": "binary",
                    "title": "Audio",
                    "type": "string"
                  },
                  "language_hint": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "en, hi or the regional language.",
                    "title": "Language Hint"
                  }
                },
                "required": [
                  "audio"
                ],
                "title": "MultiPartBodyParams",
                "type": "object"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/speech/synthesize": {
      "post": {
        "operationId": "apps_speech_api_synthesize",
        "summary": "Text to speech",
        "parameters": [],
        "responses": {
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "200": {
            "description": "16 kHz mono WAV audio of the text.",
            "content": {
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "description": "Read an answer aloud. Returns WAV audio for the Listen button.",
        "tags": [
          "speech"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SynthesizeIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/feedback": {
      "post": {
        "operationId": "apps_feedback_api_create_feedback",
        "summary": "Rate an answer or send a comment",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackOut"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "description": "Thumbs up/down on an answer (with an optional reason), or a general comment.",
        "tags": [
          "feedback"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackIn"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthOut": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "stubs": {
            "title": "Stubs",
            "type": "boolean"
          },
          "database": {
            "enum": [
              "ok",
              "unreachable"
            ],
            "title": "Database",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "stubs",
          "database"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "AskOut": {
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "answer_text": {
            "title": "Answer Text",
            "type": "string"
          },
          "status": {
            "enum": [
              "answered",
              "partial",
              "declined"
            ],
            "title": "Status",
            "type": "string"
          },
          "needs_state": {
            "description": "True when the user must choose a state first.",
            "title": "Needs State",
            "type": "boolean"
          },
          "citations": {
            "description": "Always empty for a declined answer.",
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "title": "Citations",
            "type": "array"
          },
          "followups": {
            "items": {
              "type": "string"
            },
            "title": "Followups",
            "type": "array"
          },
          "contact": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContactOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "Always set for a declined answer."
          },
          "is_demo": {
            "description": "True for stub or cached answers.",
            "title": "Is Demo",
            "type": "boolean"
          }
        },
        "required": [
          "conversation_id",
          "message_id",
          "answer_text",
          "status",
          "needs_state",
          "citations",
          "followups",
          "is_demo"
        ],
        "title": "AskOut",
        "type": "object"
      },
      "CitationOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "published_date": {
            "description": "ISO date.",
            "title": "Published Date",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until a verified source URL is recorded.",
            "title": "Url"
          },
          "excerpt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excerpt"
          }
        },
        "required": [
          "id",
          "document_id",
          "title",
          "publisher",
          "published_date",
          "page"
        ],
        "title": "CitationOut",
        "type": "object"
      },
      "ContactOut": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "label",
          "detail"
        ],
        "title": "ContactOut",
        "type": "object"
      },
      "ErrorOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "AskIn": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omit on the first question; reuse the returned id.",
            "title": "Conversation Id"
          },
          "text": {
            "description": "The question, typed or confirmed transcript.",
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "language": {
            "default": "en",
            "description": "Short ISO code: en, hi or the regional language.",
            "title": "Language",
            "type": "string"
          },
          "state": {
            "anyOf": [
              {
                "maxLength": 8,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "State code such as TN, or null if not chosen.",
            "title": "State"
          },
          "document_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Limit retrieval to one library document.",
            "title": "Document Id"
          }
        },
        "required": [
          "text"
        ],
        "title": "AskIn",
        "type": "object"
      },
      "TranscriptOut": {
        "properties": {
          "text": {
            "description": "Show this as an editable transcript before sending.",
            "title": "Text",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "is_demo": {
            "title": "Is Demo",
            "type": "boolean"
          }
        },
        "required": [
          "text",
          "language",
          "confidence",
          "is_demo"
        ],
        "title": "TranscriptOut",
        "type": "object"
      },
      "SynthesizeIn": {
        "properties": {
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "language": {
            "default": "en",
            "description": "Short ISO code: en, hi or the regional language.",
            "title": "Language",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "SynthesizeIn",
        "type": "object"
      },
      "FeedbackOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "title": "FeedbackOut",
        "type": "object"
      },
      "FeedbackIn": {
        "properties": {
          "message_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The answer being rated; null for general feedback.",
            "title": "Message Id"
          },
          "rating": {
            "anyOf": [
              {
                "enum": [
                  "up",
                  "down"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. 'Wrong state'.",
            "title": "Reason"
          },
          "comment": {
            "default": "",
            "maxLength": 1000,
            "title": "Comment",
            "type": "string"
          }
        },
        "title": "FeedbackIn",
        "type": "object"
      }
    }
  },
  "servers": []
}