# Copy to backend/.env for local development. Never commit .env.

# --- Django ---
DJANGO_DEBUG=true
# Required outside development: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Unset = SQLite file (backend/db.sqlite3). Compose will use PostgreSQL:
# DATABASE_URL=postgres://sahkar:sahkar@db:5432/sahkar
DATABASE_URL=
# Set to 1 behind Caddy so rate limits see the real client address.
NINJA_NUM_PROXIES=
LOG_LEVEL=INFO

# --- Behaviour shared by the team ---
# Serve stub answers, retrieval and speech until the real services land.
USE_STUBS=true
# Serve saved answers for the five scripted conversations if a service is down (Sprint 3).
DEMO_CACHE=false
# Turn off to keep no message text at all.
STORE_MESSAGES=true
REGIONAL_LANGUAGE_CODE=ta
REGIONAL_LANGUAGE_LABEL=தமிழ்
REGIONAL_LANGUAGE_ENGLISH_NAME=Tamil
COVERED_STATE_CODE=TN

# --- Agent, language model, speech (member C) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- Retrieval (member B) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=4
SCORE_THRESHOLD=0.5
QDRANT_URL=http://qdrant:6333

# --- Request limits ---
CHAT_RATE_LIMIT=20/m
SPEECH_RATE_LIMIT=20/m
FEEDBACK_RATE_LIMIT=30/m
GRIEVANCE_RATE_LIMIT=10/m
CHAT_MAX_QUESTION_CHARS=1000
SPEECH_MAX_UPLOAD_BYTES=5242880
SPEECH_MAX_SYNTH_CHARS=2000
