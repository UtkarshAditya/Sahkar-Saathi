# Copy to backend/.env for local development. Never commit .env.

# --- Django ---
DJANGO_DEBUG=true
# Required outside development: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Unset = SQLite file (backend/db.sqlite3). Compose will use PostgreSQL:
# DATABASE_URL=postgres://sahkar:sahkar@db:5432/sahkar
DATABASE_URL=
# Set to 1 behind Caddy so rate limits see the real client address.
NINJA_NUM_PROXIES=
LOG_LEVEL=INFO

# --- Behaviour shared by the team ---
# Serve stub answers, retrieval and speech until the real services land.
USE_STUBS=true
# Per-service overrides of USE_STUBS (empty = follow USE_STUBS).
# Stub retriever (canned passages) until the Qdrant retriever exists.
USE_STUB_RETRIEVER=
# false: grounded answers from the LLM below, over the retriever.
USE_STUB_ANSWER=
# false: Whisper speech-to-text (text-to-speech stays the stub).
USE_STUB_SPEECH=
# Stub grievance guide; there is no real one yet.
USE_STUB_GRIEVANCE=
# Serve saved answers for the five scripted conversations if a service is down (Sprint 3).
DEMO_CACHE=false
# Turn off to keep no message text at all.
STORE_MESSAGES=true
REGIONAL_LANGUAGE_CODE=ta
REGIONAL_LANGUAGE_LABEL=தமிழ்
REGIONAL_LANGUAGE_ENGLISH_NAME=Tamil
COVERED_STATE_CODE=TN

# --- Agent, language model, speech (member C) ---
# A label only; nothing reads it yet.
LLM_PROVIDER=ollama
# OpenAI-compatible endpoint (empty = http://localhost:11434/v1, a local Ollama).
LLM_BASE_URL=
# Model name as the server knows it (empty = llama3.1:8b).
LLM_MODEL=llama3.1:8b
# API key (empty = "ollama"; hosted providers need a real key).
LLM_API_KEY=
# Seconds before an LLM call fails (empty = 60).
LLM_TIMEOUT=
# false if the provider rejects response_format=json_object (empty = true).
LLM_JSON_MODE=
# Who a declined answer tells people to contact. Only verified details; empty = the
# district Registrar of Co-operative Societies office.
HELPLINE_LABEL=
HELPLINE_DETAIL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- Retrieval (member B) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=4
SCORE_THRESHOLD=0.5
QDRANT_URL=http://qdrant:6333

# --- Request limits ---
CHAT_RATE_LIMIT=20/m
SPEECH_RATE_LIMIT=20/m
FEEDBACK_RATE_LIMIT=30/m
GRIEVANCE_RATE_LIMIT=10/m
CHAT_MAX_QUESTION_CHARS=1000
SPEECH_MAX_UPLOAD_BYTES=5242880
SPEECH_MAX_SYNTH_CHARS=2000

# --- Speech-to-text (Whisper, used when USE_STUB_SPEECH=false) ---
# tiny, base, small, medium: bigger is slower and more accurate.
WHISPER_MODEL=small
# cpu or cuda.
WHISPER_DEVICE=cpu
# int8 on CPU, float16 on a GPU.
WHISPER_COMPUTE_TYPE=int8
# Where the model is downloaded. Leave commented out for the Hugging Face default cache
# (an empty value would mean the current folder).
# HF_HOME=/path/to/models
# Seconds the container waits for the model at start-up (Docker only).
WARM_TIMEOUT=300

# --- Documents ---
# The document list for load_sources (empty = ../data/sources.csv).
SOURCES_CSV=
